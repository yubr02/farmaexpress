   <string notr="true">QWidget {
   
	
	background-color: rgb(19, 38, 102);
}

QPushButton {
  
	background-color: rgb(170, 0, 0);
	
	color: rgb(170, 0, 0);
    color: #ffffff; /* Cor do texto */
    font-size: 15px;
    padding: 10px 25px;
    border: 1px solid transparent;
    border-radius: 4px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 10px;
    cursor: pointer;
}

QPushButton.hidden {
 
	background-color: rgb(255, 255, 255);
    border-color: #ffffff;
}

QLineEdit {
    background-color: #ffffff; /* Cor de fundo para o campo de texto */
    color: #3c6499; /* Cor do texto */
    padding: 10px 15px;
    font-size: 13px;
    border-radius: 8px;
    border: none;
    outline: none;
}

QLabel{

 
    color: #ffffff;  /* Cor do texto branca */
   
}


QRadioButton {

 
    color: #ffffff;  /* Cor do texto branca */
   
}

QLabel {
    background-color: #3c6499;  /* Cor de fundo do label */
    font-size: 12px; /* Tamanho da fonte */
    padding: 5px; /* Ajustado para 5px em todos os lados */
    border: none; /* Remove a borda completamente */
    border-radius: 20px; /* Mantém os cantos arredondados */
    font-weight: 600; /* Peso da fonte (negrito) */
    letter-spacing: 1px; /* Espaçamento entre letras de 1px */
    text-transform: uppercase; /* Transforma o texto para maiúsculas */
    margin-top: 12px; /* Margem superior de 12px */
    cursor: pointer; /* Cursor do mouse muda para pointer ao passar sobre o label */
    color: #ffffff;  /* Cor do texto branca */
}
</string>
